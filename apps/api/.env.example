# "anthropic" or "groq" - which provider backs both AI pipelines
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Only needed when AI_PROVIDER=groq. Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RESEARCH_MODEL=groq/compound

DATABASE_URL=sqlite+aiosqlite:///./bosla.db
CORS_ORIGINS=http://localhost:5173
GOAL_PLANNER_MAX_ITERATIONS=3
GOAL_PLANNER_VERIFY_LINKS=true

# Authentication. Generate a separate Google OAuth web-client for production.
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
