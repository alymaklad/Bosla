# "anthropic" or "groq" - which provider backs both AI pipelines
AI_PROVIDER=groq

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Only needed when AI_PROVIDER=groq. Get a key at https://console.groq.com
GROQ_API_KEY=
# Optional comma-separated fallback keys. Keys are tried after GROQ_API_KEY.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
# Optional comma-separated fallback models, tried after the primary model has tried every key.
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile
GROQ_RESEARCH_MODEL=groq/compound

# Local: sqlite+aiosqlite:///./bosla.db
# Vercel: use a durable external Postgres provider, e.g. postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=sqlite+aiosqlite:///./bosla.db
CORS_ORIGINS=http://localhost:5173
GOAL_PLANNER_MAX_ITERATIONS=3
GOAL_PLANNER_VERIFY_LINKS=true

# Authentication. Generate a separate Google OAuth web-client for production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# A separate authorization flow for Calendar event mirroring and two-way Tasks completion sync.
GOOGLE_SYNC_CLIENT_ID=
GOOGLE_SYNC_CLIENT_SECRET=
GOOGLE_SYNC_REDIRECT_URI=http://localhost:8000/integrations/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TASKS_LIST_ID=@default
GOOGLE_SYNC_TIMEZONE=Africa/Cairo
WEB_APP_URL=http://localhost:5173

# Personal-document RAG. Neon pgvector is enabled automatically at application startup.
# The default embedding is local and requires no additional key.
# For scanned PDFs, host the companion Google Vision service and set its authenticated URL.
OCR_FALLBACK_URL=
OCR_FALLBACK_TOKEN=
OCR_FALLBACK_TIMEOUT_SECONDS=60
# Google Cloud Vision API key for scanned-PDF OCR. Enable the Cloud Vision API
# and billing in the same Google Cloud project, and do not apply browser-only restrictions.
GOOGLE_VISION_API_KEY=
# Optional: increases public GitHub API rate limits for profile imports. Never expose this
# to the web app; private repository access needs separate per-user GitHub OAuth.
GITHUB_TOKEN=
